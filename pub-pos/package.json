{
  "name": "carwash-pos",
  "private": true,
  "version": "1.1.0",
  "description": "Carwash Bar & Restaurant POS",
  "author": "Carwash",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "electron:dev": "npx concurrently -k \"vite\" \"npx wait-on http://127.0.0.1:5173 && npx cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 npx electron .\"",
    "electron:build": "npx cross-env ELECTRON=true vite build && npx electron-builder --dir",
    "electron:dist": "npx cross-env ELECTRON=true vite build && npx electron-builder"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "@supabase/supabase-js": "^2.45.0",
    "zustand": "^5.0.0",
    "recharts": "^2.13.0",
    "lucide-react": "^0.460.0",
    "date-fns": "^4.1.0",
    "xlsx": "^0.18.5",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "vite": "^5.4.10",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "tailwindcss": "^3.4.14",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "concurrently": "^9.1.0",
    "wait-on": "^8.0.1",
    "cross-env": "^7.0.3"
  },
  "build": {
    "appId": "com.carwash.pos",
    "productName": "Carwash",
    "copyright": "Copyright Carwash Bar & Restaurant",
    "directories": {
      "output": "release",
      "buildResources": "electron/resources"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "asar": true,
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "maintainer": "carwash@local",
      "artifactName": "${productName}-${version}.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.business"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Carwash"
    },
    "icon": "electron/resources/icon.png"
  }
}
